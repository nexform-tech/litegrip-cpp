@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/litegrip_cppTargets.cmake")

# Where the factory calibration file was installed. Consumers need this to
# point the library at the data directory explicitly (LITEGRIP_DATA_DIR) when
# the run-time search would not find it.
set_and_check(litegrip_cpp_DATA_DIR
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/litegrip_cpp/calibration")

check_required_components(litegrip_cpp)
